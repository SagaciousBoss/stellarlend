{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "Cargo.toml",
    "**/Cargo.toml",
    "Cargo.lock",
    "**/Cargo.lock",
    ".cargo/config.toml",
    "rust-toolchain.toml",
    "scripts/cargo-check.sh"
  ],
  "tasks": {
    "//#cargo-check": {
      "dependsOn": [],
      "inputs": [
        "**/*.rs",
        "**/Cargo.toml",
        "**/Cargo.lock",
        ".cargo/**",
        "scripts/cargo-check.sh",
        "turbo.json"
      ],
      "outputs": [".turbo/cargo-check/**"],
      "env": [
        "CARGO",
        "CARGO_CHECK_CACHE_DIR",
        "RUSTFLAGS",
        "RUSTUP_TOOLCHAIN"
      ],
      "cache": true,
      "persistent": false
    }
  }
}
